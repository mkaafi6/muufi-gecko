<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Non-fullscreen theme: system status + navigation bars stay visible.
         Fullscreen only happens for video (handled in MainActivity). -->
    <style name="Theme.Muufi" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bar</item>
        <item name="android:navigationBarColor">@color/bar</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="colorAccent">@color/accent</item>
    </style>
</resources>
